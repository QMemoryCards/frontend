worker_processes 1;

events {}

http {

    # Docker DNS. Re-resolve the backend name so a recreated backend
    # container does not leave nginx pointing at the old IP.
    resolver 127.0.0.11 valid=10s ipv6=off;

    server {
        listen 80;

        # Serve static files with correct content-type
        location / {
            include /etc/nginx/mime.types;
            root /usr/share/nginx/html;
            try_files $uri $uri/ /index.html;
            index index.html;
        }

        # Proxy API requests
        location /api/ {
            set $backend http://${BACKEND_HOST}:${BACKEND_PORT};
            proxy_pass $backend$request_uri;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }
    }
}
